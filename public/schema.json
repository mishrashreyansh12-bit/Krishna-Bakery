    {
      "@type": "FAQPage",
      "@id": "https://stirring-madeleine-7eec5d.netlify.app/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is AI Customizer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AI Customizer is our innovative feature that helps you find the perfect cake based on your mood, preferences, and occasion. Just answer a few questions and let AI suggest the ideal dessert for you!"
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer same-day delivery?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! For orders under ₹600 placed before 2 PM, we offer same-day delivery in Delhi and nearby areas. Pre-order options are also available for larger cakes."
          }
        },
        {
          "@type": "Question",
          "name": "Are your cakes eggless?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer both eggless and egg-based cakes. Most of our premium collection items are available in eggless variants. Please specify your preference while ordering."
          }
        },
        {
          "@type": "Question",
          "name": "Can I customize my cake?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Absolutely! Many of our items are customizable. You can add custom messages, change flavors, adjust sizes, and more. Select the ✏️ icon on any customizable item."
          }
        },
        {
          "@type": "Question",
          "name": "What is the referral program?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Refer friends to Luxholic and earn ₹100 credit per successful referral. Your friends get ₹60 OFF on their first order and you earn rewards!"
          }
        },
        {
          "@type": "Question",
          "name": "Do you have promo codes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! We offer various promo codes: WELCOME60 (₹60 OFF first order), COMBO15 (15% OFF combos), FIRST50, SWEET80, BAKE125, and ROYAL200. View all offers in the Offers section."
          }
        },
        {
          "@type": "Question",
          "name": "How is delivery charged?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Delivery is FREE for all orders! We believe quality desserts should be accessible to everyone. No hidden charges."
          }
        },
        {
          "@type": "Question",
          "name": "What payment methods do you accept?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We accept all major payment methods: Credit/Debit cards, UPI (Google Pay, PhonePe, Paytm), Wallets, and Cash on Delivery options."
          }
        }
      ]
